(defconstant +key-1+ 2)
(defconstant +key-2+ 3)
(defconstant +key-3+ 4)
(defconstant +key-4+ 5)
(defconstant +key-5+ 6)
(defconstant +key-6+ 7)
(defconstant +key-7+ 8)
(defconstant +key-8+ 9)
(defconstant +key-9+ 10)
